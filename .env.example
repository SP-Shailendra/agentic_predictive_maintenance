# Copy to .env before running Docker Compose.
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://maintenance:change-me@db:5432/maintenance
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
API_KEY=
METRICS_API_KEY=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
CMMS_API_URL=
CMMS_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=5
TELEMETRY_RETENTION_DAYS=0
RATE_LIMIT_REQUESTS_PER_MINUTE=120
DEFAULT_VIBRATION_THRESHOLD_MM_S=7.1
DEFAULT_TEMPERATURE_THRESHOLD_C=85
KNOWLEDGE_MAX_UPLOAD_MB=10
APPROVAL_STALE_AFTER_MINUTES=60
APPROVAL_SLA_MINUTES=60
FRONTEND_BASE_URL=http://localhost:4173
NOTIFICATION_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_FORMAT=slack
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:4173/
VITE_OIDC_ROLES_CLAIM=roles
